{
  // The sandbox's side shared by the tabs and the worker: the protocol, with
  // a browser's types and none of Node's. The tests run on Node 24, which runs
  // the TypeScript as it is: erasableSyntaxOnly refuses what it could not strip.
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/protocol.ts"]
}
