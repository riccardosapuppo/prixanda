{
  "name": "contracts",
  "private": true,
  "type": "module",
  "description": "The commerce engine's gRPC contract as JavaScript with type declarations, generated from proto/ by `npm run proto`.",
  "license": "Apache-2.0",
  "exports": {
    "./commerce/v1/*": {
      "types": "./gen/commerce/v1/*_pb.d.ts",
      "default": "./gen/commerce/v1/*_pb.js"
    },
    "./grpc/health/v1/*": {
      "types": "./gen/grpc/health/v1/*_pb.d.ts",
      "default": "./gen/grpc/health/v1/*_pb.js"
    }
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0"
  }
}
