{
  "name": "subscription-offers-platform",
  "private": true,
  "type": "module",
  "description": "A subscription and pricing operations platform: offers, prices, approvals and catalog publication across markets, explored through a fictional independent-music service.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "services/gateway",
    "apps/site",
    "apps/console"
  ],
  "scripts": {
    "build": "node tools/setup.ts && tsc -p tsconfig.json",
    "test": "node tools/check.ts",
    "setup": "node tools/setup.ts",
    "db": "node tools/db.ts",
    "engine": "node tools/engine.ts",
    "check": "node tools/check.ts",
    "measure": "node tools/measure.ts",
    "licenses": "node tools/licenses.ts",
    "typecheck": "tsc -p tsconfig.json",
    "proto": "node tools/proto.ts",
    "graphql": "node tools/graphql.ts",
    "gateway": "node services/gateway/src/node/main.ts",
    "design": "node packages/design/scripts/generate.ts",
    "console:stack": "node apps/console/scripts/stack.ts",
    "demo:build": "node tools/demo.ts build",
    "demo:serve": "node tools/demo.ts serve"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@graphql-codegen/core": "6.2.2",
    "@graphql-codegen/typescript": "6.1.2",
    "@graphql-codegen/typescript-resolvers": "6.1.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "typescript": "6.0.3"
  },
  "optionalDependencies": {
    "@embedded-postgres/linux-x64": "18.4.0-beta.17",
    "@embedded-postgres/windows-x64": "18.4.0-beta.17"
  },
  "allowScripts": {
    "@embedded-postgres/linux-x64@18.4.0-beta.17": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "@bufbuild/buf@1.73.0": true,
    "@apollo/protobufjs@1.2.8": false,
    "esbuild@0.28.2": false
  },
  "overrides": {
    "playwright-core": "1.62.1"
  }
}
