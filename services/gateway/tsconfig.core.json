{
  // The core alone (schemas, resolvers, loaders), with the types of a browser
  // and none of Node's: in stage 8 it runs in a page, so a Buffer, a process or
  // a node: import here does not compile. test/core-boundary.test.ts checks its
  // imports as well.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["es2024", "dom"],
    "types": []
  },
  "include": ["src/core/**/*.ts"]
}
